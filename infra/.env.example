# cicd-ai-flow infra/.env  (copy of .env.example made by scripts/up.sh; never commit)
# Values with spaces or special characters should be double-quoted.

# --- GitHub (needed for the GitHub multibranch jobs; empty = jobs are created but not scanned)
GITHUB_OWNER=
GITHUB_REPO=cicd-ai-flow
GITHUB_USERNAME=
GITHUB_TOKEN=

# --- Gemini (AI code review); empty = AI review stage is marked UNSTABLE
GEMINI_API_KEY=

# --- Jenkins admin (JCasC local security realm)
JENKINS_ADMIN_PASSWORD=admin

# --- SonarQube admin (bootstrap-sonar.sh changes the initial admin/admin to this; MUST be >= 12 characters)
SONAR_ADMIN_PASSWORD=Admin1234!Sonar
# filled automatically by bootstrap-sonar.sh (global analysis token "jenkins")
SONAR_TOKEN=

# --- gid of /var/run/docker.sock as seen inside containers (auto-detected by up.sh)
DOCKER_GID=1001
