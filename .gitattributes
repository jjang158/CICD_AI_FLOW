# Normalize line endings: everything LF in the repository and on checkout,
# except Windows batch files which must stay CRLF.
* text=auto eol=lf

gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
